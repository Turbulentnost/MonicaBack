# AI completion via isolated LM Studio proxy (OpenAI-compatible, no JWT)
# Prod Monica calls GPU host :8000; GPU host proxies to local LM Studio :1234
AI_COMPLETION_ENABLED=1
OPENAI_BASE_URL=http://193.105.37.142:8000/api/lmstudio/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-vl-8b-thinking
AI_MAX_TOKENS=200
AI_RATE_PER_MINUTE=20
AI_MIN_DRAFT_LEN=1
AI_REQUEST_TIMEOUT_SEC=45
AI_CONTEXT_WINDOW_TOKENS=125000
AI_CONTEXT_RESERVE_TOKENS=512
AI_EMBEDDING_ENABLED=1
AI_EMBEDDING_DIMS=1024
AI_TOPIC_SIM_THRESHOLD=0.45
AI_TOPIC_GAP_MINUTES=25
